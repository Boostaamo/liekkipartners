# Kopioi tiedostoksi .env.local paikalliseen kehitykseen. Älä koskaan commitoi oikeita arvoja.
# Tuotannossa arvot asetetaan Vercelin ympäristömuuttujiin (Project Settings > Environment Variables).

# Sivuston julkinen osoite (ilman loppukauttaviivaa)
NEXT_PUBLIC_SITE_URL=https://www.example.fi

# Lomakkeen liidit lähetetään tähän osoitteeseen (CRM, Odoo, automaatio tai muu liidirekisteri)
LEAD_WEBHOOK_URL=
# Valinnainen jaettu salaisuus, lähetetään otsikossa X-Webhook-Secret
LEAD_WEBHOOK_SECRET=

# Google Analytics 4 -tunnus (muoto G-XXXXXXXXXX). Ladataan vain evästesuostumuksen jälkeen.
NEXT_PUBLIC_GA_ID=
